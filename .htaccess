<IfModule mod_rewrite.c>
    Options -Indexes
    RewriteEngine On

    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF-Token:%{HTTP:X-XSRF-Token}]

    # Route /resources as an app route (the framework resources/ directory collides with it)
    RewriteRule ^resources/?$ index.php [L]

    # Serve storage/ from public/storage/ (bypasses storage/.htaccess Deny rules)
    RewriteRule ^storage/(.*)$ public/storage/$1 [L]

    # Serve static assets that live under public/
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(build|images|js|css|uploads|view|storage|favicon\.ico|robots\.txt|logo\.jpg|google.*\.html)(/.*)?$ public/$1$2 [L]

    # Route everything else to root index.php
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
